# ==========================================
# CRM系统环境变量配置模板
# 使用说明：
# 1. 复制此文件为 .env
# 2. 修改所有包含 "CHANGE_ME" 的值
# 3. 生产环境请使用强密码
# ==========================================

# 数据库配置
DB_HOST=localhost
DB_PORT=3307
DB_NAME=crm_system
DB_USER=crm_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# JWT配置（生产环境必须使用强随机密钥）
JWT_SECRET=CHANGE_ME_USE_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=7d

# 应用配置
NODE_ENV=development
PORT=3000

# 前端配置
VITE_API_BASE_URL=http://localhost:3000/api

# ==========================================
# 生产环境额外配置
# ==========================================
# 取消注释并配置以下选项用于生产环境

# 日志级别: error, warn, info, debug
# LOG_LEVEL=info

# CORS允许的域名（多个用逗号分隔）
# CORS_ORIGIN=https://your-domain.com

# 文件上传大小限制（MB）
# UPLOAD_MAX_SIZE=10

# Session密钥
# SESSION_SECRET=CHANGE_ME_STRONG_SESSION_SECRET
